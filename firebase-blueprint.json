        "type": {
          "type": "string",
          "enum": ["lent", "borrowed"]
        },
        "amount": {
          "type": "number"
        },
        "paidAmount": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dueDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
        },
        "note": {
          "type": "string",
          "maxLength": 300
