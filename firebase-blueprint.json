    "TransactionDoc": {
      "title": "TransactionDoc",
      "description": "Individual income, expense, or wallet transfer transaction.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense", "transfer"]
