{
  "entities": {
    "UserProfileDoc": {
      "title": "UserProfileDoc",
      "description": "Private user account profile, preferences, and security settings.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email address (PII).",
          "minLength": 3,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "description": "User display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "currency": {
          "type": "string",
          "description": "Preferred active display currency symbol.",
          "minLength": 1,
          "maxLength": 10
        },
        "baseCurrency": {
          "type": "string",
          "description": "Underlying base currency symbol in which ledger numbers are stored.",
          "minLength": 1,
          "maxLength": 10
        },
        "pin": {
          "type": "string",
          "description": "Optional 4-digit local app lock PIN.",
          "maxLength": 4,
          "pattern": "^([0-9]{4})?$"
        },
        "pinLock": {
          "type": "boolean",
          "description": "Whether the 4-digit PIN lock is enabled."
        },
        "darkMode": {
          "type": "boolean",
          "description": "Whether dark mode is enabled."
        },
        "hideBalance": {
          "type": "boolean",
          "description": "Whether balances are masked in the UI."
        },
        "language": {
          "type": "string",
          "description": "UI language preference.",
          "enum": ["bn", "en"]
        },
        "themeConfig": {
          "type": "object",
          "description": "Theme Studio appearance configuration.",
          "properties": {
            "surface": { "type": "string", "enum": ["light", "warm", "dark", "amoled"] },
            "accentColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
            "cardStyle": { "type": "string", "enum": ["gradient", "glass", "minimal"] },
            "radius": { "type": "string", "enum": ["rounded", "sharp"] },
            "density": { "type": "string", "enum": ["cozy", "compact"] },
            "fontScale": { "type": "string", "enum": ["sm", "md", "lg"] }
          },
          "required": ["surface", "accentColor", "cardStyle", "radius", "density", "fontScale"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was last updated."
        }
      },
      "required": [
        "ownerId",
        "email",
        "name",
        "currency",
        "pin",
        "pinLock",
        "darkMode",
        "hideBalance",
        "language",
        "createdAt",
        "updatedAt"
      ]
    },
    "WalletAccountDoc": {
      "title": "WalletAccountDoc",
