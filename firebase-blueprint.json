        "amount": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "subcategory": {
          "type": "string",
          "maxLength": 120
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "walletId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toWalletId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientCreatedAt": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "type",
        "title",
        "amount",
        "category",
        "date",
        "walletId",
        "clientCreatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "DebtRecordDoc": {
      "title": "DebtRecordDoc",
